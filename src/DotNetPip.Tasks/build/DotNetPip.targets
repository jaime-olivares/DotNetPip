<Project>
  <PropertyGroup>
    <_DotNetPipTaskAssembly Condition="'$(_DotNetPipTaskAssembly)' == '' AND Exists('$(MSBuildThisFileDirectory)..\tools\DotNetPip.Tasks.dll')">$(MSBuildThisFileDirectory)..\tools\DotNetPip.Tasks.dll</_DotNetPipTaskAssembly>
    <_DotNetPipTaskAssembly Condition="'$(_DotNetPipTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\DotNetPip.Tasks.dll</_DotNetPipTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="DotNetPip.Tasks.EnsurePythonEnvironment" AssemblyFile="$(_DotNetPipTaskAssembly)" Condition="'$(_DotNetPipTaskAssembly)' != ''" />

  <Target Name="RestorePythonPackages"
          AfterTargets="Restore;ResolveProjectReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(_DotNetPipTaskAssembly)' != ''">
    <EnsurePythonEnvironment
      PackageReferences="@(PythonPackageReference)"
      OutputDirectory="$(TargetDir)"
      PythonVersion="$(PythonRuntimeVersion)"
      PythonExecutable="$(PythonExecutable)"
      ForceRestore="$(DotNetPipForcePythonRestore)"
      LockFilePath="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)python.lock.json"
      RestoreLockedMode="$(RestoreLockedMode)" />
  </Target>
</Project>
