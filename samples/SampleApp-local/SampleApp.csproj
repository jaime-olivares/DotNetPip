<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PythonRuntimeVersion>3.11.5</PythonRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DotNetPip/DotNetPip.csproj" />
    <ProjectReference Include="../../src/DotNetPip.Tasks/DotNetPip.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="../../src/DotNetPip.Tasks/build/DotNetPip.targets" />

  <!-- Declarative Python Dependencies -->
  <ItemGroup>
    <PythonPackageReference Include="transformers" Version="4.35.0" />
    <PythonPackageReference Include="torch" Version="2.1.0" />
  </ItemGroup>

</Project>
