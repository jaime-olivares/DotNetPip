<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PythonRuntimeVersion>3.11.5</PythonRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetPip\DotNetPip.csproj" />
  </ItemGroup>

  <Import Project="..\DotNetPip.Tasks\build\DotNetPip.targets" />

  <!-- Declarative Python Dependencies -->
  <ItemGroup>
    <PythonPackageReference Include="transformers" Version="4.35.0" />
    <PythonPackageReference Include="torch" Version="2.1.0" />
  </ItemGroup>

</Project>
