<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>DotNetPip</PackageId>
    <Authors>Jaime Olivares</Authors>
    <Version>1.0.0</Version>
    <Title>DotNetPip</Title>
    <Description>Universal In-Process C# - Python Interoperability Engine for .NET 10</Description>
    <PackageTags>python;interop;ai;ml;pytorch;huggingface;msbuild;dotnet</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\</PackageOutputPath>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeDotNetPipTaskAssembly</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="$(PackageLicenseFile)" />
    <None Include="..\README.md" Pack="true" PackagePath="$(PackageReadmeFile)" />
    <None Include="..\DotNetPip.Tasks\build\DotNetPip.targets" Pack="true" PackagePath="build/DotNetPip.targets" />
    <None Include="..\DotNetPip.Tasks\build\DotNetPip.targets" Pack="true" PackagePath="buildTransitive/DotNetPip.targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetPip.Tasks\DotNetPip.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="_IncludeDotNetPipTaskAssembly">
    <PropertyGroup>
      <_DotNetPipTasksDll>$(MSBuildThisFileDirectory)..\DotNetPip.Tasks\bin\$(Configuration)\$(TargetFramework)\DotNetPip.Tasks.dll</_DotNetPipTasksDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DotNetPipTasksDll)')"
           Text="DotNetPip.Tasks.dll was not found at '$(_DotNetPipTasksDll)'. Build DotNetPip.Tasks before packing." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_DotNetPipTasksDll)">
        <PackagePath>tools/DotNetPip.Tasks.dll</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
